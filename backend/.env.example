JWT_SECRET = "your_secret_key_here" # Secreto para la firma de tokens JWT

DB_HOST="localhost" # Host de la base de datos PostgreSQL
DB_PORT=5432 # Puerto de la base de datos
DB_USER="your_db_user" # Usuario de la base de datos
DB_PASSWORD="your_db_password" # Contraseña de la base de datos
DB_NAME="your_db_name" # Nombre de la base de datos

EMAIL_SENDER="your_email@example.com" # Dirección de email del remitente (ej. info@midominio.com)
EMAIL_SENDER_PASSWORD="your_email_password" # Contraseña o App Password del proveedor de email
EMAIL_SENDER_PORT=587 # Puerto SMTP
EMAIL_SENDER_HOST="smtp.example.com" # Servidor SMTP (ej. smtp.zoho.eu o smtp.gmail.com)

REDIS_URL="redis://localhost:6379" # URL de conexión a Redis para cache/colas

TTS_SERVICE_URL="http://localhost:7860" # URL donde corre el contenedor/servicio de TTS
